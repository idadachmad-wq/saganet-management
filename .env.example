NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key
AUTH_SECRET=generate-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
AUTH_URL=https://your-app.vercel.app

# --- Vercel Environment Variables ---
# NEXT_PUBLIC_SUPABASE_URL     → Environment (bukan Secret)
# NEXT_PUBLIC_SUPABASE_ANON_KEY → Environment (bukan Secret)
# SUPABASE_SERVICE_ROLE_KEY    → Secret
# AUTH_SECRET                  → Secret (WAJIB; tanpa ini login error Configuration)
# AUTH_TRUST_HOST              → Environment = true
# AUTH_URL                     → Environment = https://....vercel.app (opsional)
#
# Setelah mengubah env di Vercel: Deployments → … → Redeploy
